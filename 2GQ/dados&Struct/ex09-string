#include <stdio.h>

#define TAM 50

void lerStr (char str[], int tamMax);
int meuStrLen (char str[]);
void meuStrCpy (char strDestino[], char strOrigem);

int main() {
    char frase[TAM];
    printf("Digite uma frase: ");
    //scanf("%49[^\n]", frase);
    //fgets(frase, TAM, stdin);
    lerStr(frase, TAM);
    printf("A frase digitada foi: '%s'", frase);
    return 0;
}

void lerStr (char str[], int tamMax) {
    fgets(str, tamMax, stdin);
    int tam = strlen(str);
    if (tam > 0 && str[tam - 1] == '\n') {
        str[tam - 1] = '\0';
    }
}

int meuStrLen(char str[]) {
    int tam = 0;
    while (str[tam] != '\0') {
        tam += 1;
    }
    return tam;
}

void meuStrCpy (char strDestino[], char strOrigem) {
    int i = 0;
    while (strOrigem[i] = '\0') {
        strDestino[i] = strOrigem[i];
        i+= 1;
    }
    strDestino[i] = '\0';
}